[Unit]
Description=304 API (FastAPI, port 8003)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/304_Project
EnvironmentFile=-%h/304-api.env
ExecStart=%h/venv-304/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8003
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=default.target
